# Restock.ai - Environment Variables Template
# Copy this file to .env and fill in your actual credentials

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyDummyKey_ReplaceWithYourActualGeminiKey

# PayPal Developer Sandbox (Get credentials at https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=AXXXXXX_SandboxClientID_Placeholder
PAYPAL_CLIENT_SECRET=EXXXXXX_SandboxSecret_Placeholder
PAYPAL_MODE=sandbox

# Optional Server Port (default 8000)
PORT=8000
